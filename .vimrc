filetype plugin indent on
syntax on
set expandtab tabstop=2 softtabstop=2 shiftwidth=2
set nocompatible number autoindent smartindent cursorline showcmd wildmenu autoread
set background=dark
set clipboard+=unnamed
highlight EndOfBuffer ctermfg=darkgray
highlight CursorLine ctermbg=black term=none cterm=none
highlight CursorLineNr term=none cterm=none
highlight LineNr ctermfg=black term=none cterm=none
let &t_SI = "\<Esc>[6 q"
let &t_EI = "\<Esc>[2 q"
